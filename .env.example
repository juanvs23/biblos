# Biblos environment variables (see openspec/changes/biblos-mcp-core/design.md)
# Copy to .env for local runs. No default is safe for the auth pair: the server
# refuses to start without BIBLOS_API_KEY and BIBLOS_ALLOWED_ORIGINS (enforced
# in the server work unit; they are optional here for the domain/persistence layers).

# --- Auth (required at the HTTP server boundary, later work unit) ---
BIBLOS_API_KEY=
BIBLOS_ALLOWED_ORIGINS=

# --- Persistence ---
DB_PATH=/opt/biblos/biblos.db

# --- Search ---
# Optional: drop keyword search hits below this normalized score (0 = keep all)
BIBLOS_MIN_SCORE=0

# --- HTTP bind (server work unit) ---
BIBLOS_HOST=127.0.0.1
BIBLOS_PORT=8199
