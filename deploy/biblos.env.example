# Biblos production environment (VPS) — task 9.1.
# Copy to /etc/biblos/biblos.env and make it root-owned, mode 600:
#   sudo install -m 600 deploy/biblos.env.example /etc/biblos/biblos.env
# The systemd unit reads this file via EnvironmentFile=/etc/biblos/biblos.env.
# NEVER commit a real API key — generate one on the VPS with:
#   openssl rand -hex 32

# --- Auth (REQUIRED — the server refuses to start without these) ---
BIBLOS_API_KEY=
# Comma-separated Origin allowlist (REQ-core-auth: disallowed/missing Origin -> 403).
# Include the Origin each client actually sends — see docs/clients.md.
BIBLOS_ALLOWED_ORIGINS=

# --- Persistence (single SQLite file, REQ-core-persistence) ---
DB_PATH=/opt/biblos/biblos.db

# --- Search ---
# Optional: drop keyword search hits below this normalized score (0 = keep all)
BIBLOS_MIN_SCORE=0

# --- HTTP bind (loopback only; Apache proxies biblos.coltmandev.dev -> this) ---
BIBLOS_HOST=127.0.0.1
BIBLOS_PORT=8199
